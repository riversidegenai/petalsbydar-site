# Public site URL (no trailing slash). Use the Vercel preview URL for now.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Vercel Postgres or Neon — copy the connection string)
DATABASE_URL=postgres://user:password@host/db

# Square Appointments booking URL — customers are sent here AFTER paying on
# the website, to pick a pickup time. From her Square dashboard:
# Appointments → Online Booking → Share link.
# Looks like one of:
#   https://book.squareup.com/appointments/<id>/location/<id>/services
#   https://petalsbydar.square.site/s/appointments
NEXT_PUBLIC_SQUARE_BOOKING_URL=

# Square Web Payments — takes deposit/full payment on-site before the
# Appointments redirect above. Create a Developer app at
# https://developer.squareup.com/apps and grab these from its Credentials tab.
# Use sandbox values while testing; switch to production keys to go live.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Exposed to the browser so the Web Payments SDK can load. Same value as
# SQUARE_APPLICATION_ID — duplicated because env vars without the
# NEXT_PUBLIC_ prefix aren't available to client components.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
# Webhook signature key — added after deploying so Square knows where to send
# payment.updated events. Generated in the Webhooks → Subscriptions tab of
# the Square Developer dashboard.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Resend (email) — used to notify the owner when someone submits order
# details so she can match the website submission with the Square booking.
RESEND_API_KEY=re_...
OWNER_NOTIFICATION_EMAIL=hello@petalsbydar.com

# Cloudflare R2 (inspiration uploads) — zero-egress object storage. Customers
# upload reference photos here; the florist views them via the public URL.
# Set up: Cloudflare dashboard → R2 → create bucket → create an API token
# (Object Read & Write) → enable public access (r2.dev) or attach a custom
# domain. See R2_SETUP.md for step-by-step.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=petalsbydar-inspiration
# Public read URL for the bucket (no trailing slash). Either the r2.dev URL
# Cloudflare gives you, e.g. https://pub-xxxxxxxx.r2.dev, or a custom domain
# like https://media.petalsbydar.com
R2_PUBLIC_BASE_URL=

# Legacy: Vercel Blob is no longer used (replaced by R2 above). Safe to remove.
# BLOB_READ_WRITE_TOKEN=

# Sentry (error tracking) — create a project at sentry.io → Next.js, grab the DSN.
# SENTRY_DSN is server-only; NEXT_PUBLIC_SENTRY_DSN is the same value exposed to
# the browser so client-side errors are also captured.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Admin (Basic auth password for /admin — username can be anything)
ADMIN_PASSWORD=change-me
