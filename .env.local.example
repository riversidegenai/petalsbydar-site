# Public site URL (no trailing slash). Use the Vercel preview URL for now.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Vercel Postgres or Neon — copy the connection string)
DATABASE_URL=postgres://user:password@host/db

# Stripe — test keys for local, live keys in prod
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email)
RESEND_API_KEY=re_...
OWNER_NOTIFICATION_EMAIL=hello@petalsbydar.com

# Twilio (SMS to owner)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15555550100
OWNER_SMS_NUMBER=+15555550199

# Vercel Blob (inspiration uploads)
BLOB_READ_WRITE_TOKEN=

# Admin (Basic auth password for /admin — username can be anything)
ADMIN_PASSWORD=change-me
